# 管理 Bot（仅用于交互管理来源，不涉及转发/推送）
BOT_TOKEN=8242452624:AAEennPH3otY11-QbVL86iq9RF_JOEtZ_So
# 管理员用户ID列表，逗号分隔，例如：123456789,987654321
ADMIN_USER_IDS=7025369609
# 代理（可选）
PROXY_ENABLED=false
PROXY_TYPE=socks5
PROXY_HOST=127.0.0.1
PROXY_PORT=7890
PROXY_USERNAME=
PROXY_PASSWORD=

# 下载目录
DOWNLOAD_ROOT_DIR=./downloads
# 媒体组聚合等待时间（秒）：相册消息需要等待同组消息到齐
MEDIA_GROUP_FLUSH_SECONDS=2.0
# 下载并发（全局）：同时下载的媒体消息数量
MAX_DOWNLOAD_CONCURRENCY=5
# 媒体组并发（全局）：同时处理的“媒体组/单条媒体”数量（组级并发）
MAX_GROUP_CONCURRENCY=5
# 管理 Bot：话题选择分页大小（5-20）
BOT_TOPIC_PAGE_SIZE=10
# 管理 Bot：来源列表分页大小（3-12）
BOT_SOURCE_PAGE_SIZE=8
# 动态来源缓存刷新间隔（秒）
SOURCES_CACHE_TTL_SECONDS=5.0

# rclone 上传（可选）
RCLONE_ENABLED=false
# 例如：pikpak:
RCLONE_REMOTE=
# remote 下的根目录（可选）
RCLONE_REMOTE_BASE_DIR=TGDownloads
# 上传成功后删除本地组目录
RCLONE_DELETE_LOCAL_AFTER_UPLOAD=true
# 额外参数（空格分隔），例如：--transfers 2 --checkers 4
RCLONE_EXTRA_ARGS=

# 日志
DEBUG=false
