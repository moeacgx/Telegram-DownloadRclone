# Telegram API
API_ID=
API_HASH=
USER_PHONE=

# 管理 Bot（仅用于交互管理来源，不涉及转发/推送）
BOT_TOKEN=
# 管理员用户ID列表，逗号分隔，例如：123456789,987654321
ADMIN_USER_IDS=
# 代理（可选）
PROXY_ENABLED=false
PROXY_TYPE=socks5
PROXY_HOST=127.0.0.1
PROXY_PORT=7890
PROXY_USERNAME=
PROXY_PASSWORD=

# 下载目录
DOWNLOAD_ROOT_DIR=./downloads
# 命名规则：留空则不加前缀
# 相册子目录前缀（会拼接最小消息ID），例如：TG@BieLaoZai_7304/
TG_MEDIA_FOLDER_PREFIX=TG@BieLaoZai_
# 落盘文件名前缀（会拼接消息ID），例如：TG@BieLaoZai_7304.mp4
TG_MEDIA_FILE_PREFIX=TG@BieLaoZai_
# 媒体组聚合等待时间（秒）：相册消息需要等待同组消息到齐
MEDIA_GROUP_FLUSH_SECONDS=2.0
# 下载并发（全局）：同时下载的媒体消息数量
MAX_DOWNLOAD_CONCURRENCY=5
# 媒体组并发（全局）：同时处理的“媒体组/单条媒体”数量（组级并发）
MAX_GROUP_CONCURRENCY=5
# 管理 Bot：话题选择分页大小（5-20）
BOT_TOPIC_PAGE_SIZE=10
# 管理 Bot：来源列表分页大小（3-12）
BOT_SOURCE_PAGE_SIZE=8
# 动态来源缓存刷新间隔（秒）
SOURCES_CACHE_TTL_SECONDS=5.0

# rclone 上传（可选）
RCLONE_ENABLED=false
# 例如：pikpak:
RCLONE_REMOTE=
# remote 下的根目录（可选）
RCLONE_REMOTE_BASE_DIR=TGDownloads
# 上传成功后删除本地组目录
RCLONE_DELETE_LOCAL_AFTER_UPLOAD=true
# 额外参数（空格分隔），例如：--transfers 2 --checkers 4
RCLONE_EXTRA_ARGS=

# 日志
DEBUG=false
LOG_LEVEL=INFO
# 是否输出到终端
LOG_CONSOLE=true
# 是否写入滚动日志文件
LOG_FILE_ENABLED=true
# 日志文件路径（会自动创建目录）
LOG_FILE_PATH=./logs/app.log
# 单个日志文件最大大小（字节），超过后滚动
LOG_FILE_MAX_BYTES=10485760
# 保留滚动文件数量
LOG_FILE_BACKUP_COUNT=5
# 下载日志：是否逐条消息打印（很吵，默认关闭）
LOG_DOWNLOAD_EACH_MESSAGE=false
# 是否打印完整 rclone 命令（默认关闭，减少噪音）
LOG_RCLONE_COMMAND=false
# 第三方库日志级别（过滤 telethon 的碎碎念）
LOG_TELETHON_LEVEL=WARNING
# 是否将部分 telethon 断线告警改为中文提示
LOG_TELETHON_TRANSLATE=true
# telethon 断线告警去重窗口（秒），避免刷屏
LOG_TELETHON_DEDUP_SECONDS=5

# 断线监督重连（脚本级；用于 Telethon 最终退出时自动重启连接）
TG_SUPERVISE_RECONNECT=true
# 监督重连初始等待（秒）：断线后先等一下再重连
TG_RECONNECT_DELAY_INITIAL_SECONDS=2
# 监督重连最大等待（秒）：指数退避上限
TG_RECONNECT_DELAY_MAX_SECONDS=60
# 连接健康检查：定时发轻量 ping；切换代理节点导致“卡死不动”时可自动触发重连
TG_PING_ENABLED=true
# ping 间隔（秒）：越小越灵敏，但会增加少量请求
TG_PING_INTERVAL_SECONDS=20
# ping 超时（秒）：超过即认为连接卡死，触发断开→重连
TG_PING_TIMEOUT_SECONDS=10

# 下载超时与恢复：用于“主连接没死，但媒体下载卡住”的情况（例如切换节点后 borrowed sender 卡死）
TG_DOWNLOAD_TIMEOUT_SECONDS=300
TG_DOWNLOAD_RETRY_ATTEMPTS=2
# 自适应超时：根据文件大小估算下载最长时长（最终取 max(硬超时, 自适应超时)）
TG_DOWNLOAD_TIMEOUT_BASE_SECONDS=30
# 估算用最低下载速度（字节/秒），例如 256KB/s
TG_DOWNLOAD_MIN_BYTES_PER_SEC=262144
# 无进度超时（秒）：下载长时间没有任何进度回调则判定卡死并重试
TG_DOWNLOAD_STALL_SECONDS=180
# 克隆断线重试次数：克隆过程中断线会重连并重试
TG_CLONE_RETRY_ATTEMPTS=3
# 媒体组级重试：避免“下载协程里主动断线”导致 Telethon 内部重连竞态
TG_GROUP_RETRY_ATTEMPTS=2
TG_GROUP_RETRY_DELAY_SECONDS=2
# 已存在同 msg_id 文件则跳过（防止产生 " (1)" 文件）
TG_SKIP_EXISTING_MEDIA=true
# 原子替换：先下载到临时文件，再替换为 `<msg_id>.<ext>`（避免 Telethon 自动重命名）
TG_ATOMIC_REPLACE_MEDIA=true
# 下载完成后校验文件大小（视频/文件类媒体更可靠；不一致会删除并触发重试）
TG_VERIFY_MEDIA_SIZE=true
# 大小校验容差（字节），避免极少数边界误差；建议 0 或 1048576(1MB)
TG_SIZE_MISMATCH_TOLERANCE_BYTES=1048576
